{{- /*
  API keys for fish. Each value is read from the system keyring first (service
  "chezmoi-zsh-secrets", populated by bw-keyring-sync). If secret-tool is missing,
  the keyring is locked or absent, or the entry is empty, that value falls back to
  the Bitwarden item below, which needs an unlocked vault (rbw unlock). Set
  CHEZMOI_SECRETS_BITWARDEN=1 to skip the keyring.

  Same service, keyring entries, and Bitwarden item as the .zsh_secrets template,
  so both templates (and bw-keyring-sync) keep working unchanged. Values are
  emitted as single-quoted fish strings with backslashes and single quotes
  escaped, which is valid fish for any secret value.
*/ -}}
{{- $svc := "chezmoi-zsh-secrets" -}}
{{- $bwItem := "chezmoi/zsh-secrets" -}}
{{- $names := list "GOOGLE_API_KEY" "GOOGLE_DEFAULT_CLIENT_ID" "GOOGLE_DEFAULT_CLIENT_SECRET" "OPENROUTER_API_KEY" "NOCTALIA_WALLHAVEN_API_KEY" "ACOUSTID_API_KEY" "DISCOGS_USER_TOKEN" "GEMINI_API_KEY" "GEMINI_FREE_API_KEY" "MISTRAL_API_KEY" -}}
{{- $useKeyring := and (lookPath "secret-tool") (not (env "CHEZMOI_SECRETS_BITWARDEN")) -}}
{{- range $names -}}
{{- $v := "" -}}
{{- if $useKeyring -}}
{{- $v = output "sh" "-c" (printf "timeout 5 secret-tool lookup service %s username %s 2>/dev/null || true" $svc .) | trim -}}
{{- end -}}
{{- if not $v -}}
{{- $v = (index (rbwFields $bwItem) .).value -}}
{{- end -}}
set -gx {{ . }} '{{ regexReplaceAllLiteral `'` (regexReplaceAllLiteral `\\` $v `\\`) `\'` }}'
{{ end -}}

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/tux.png",
    "type": "kitty-direct",
    "width": 25,
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "os",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "format": "{release}"
    },
    "uptime",
    {
      "type": "battery",
      "format": "{/4}{-}{/}{4}{?5} [{5}]{?}"
    },
    "break",
    {
      "type": "packages",
      "key": "Packages",
      "format": "{all}"
    },
    {
      "type": "shell",
      "key": "Shell",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "format": "{pretty-name}"
    },
    "break",
    {
      "type": "cpu",
      "key": "CPU",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "format": "{2}"
    },
    {
      "type": "memory",
      "format": "{used} / {total}"
    }
  ],
  "display": {
    "color": {
      "keys": "#9ecafc",
      "title": "#bac8db"
    },
    "percent": {
      "color": {
        "green": "#d5bee5",
        "yellow": "#9ecafc",
        "red": "#ffb4ab"
      }
    }
  }
}

#!/usr/bin/env bash
# bw-keyring-sync: copy the custom fields of a Bitwarden item into the system
# keyring (Secret Service, e.g. gnome-keyring) so chezmoi can read them without
# touching Bitwarden (uses rbw). Values are never printed.
set -euo pipefail

ITEM="chezmoi/zsh-secrets"
SERVICE="chezmoi-zsh-secrets"
DRY_RUN=0
LOCK_AFTER=0

usage() {
    cat <<EOF
Usage: ${0##*/} [options]

  -i, --item NAME      Bitwarden item to read   (default: $ITEM)
  -s, --service NAME   keyring service name     (default: $SERVICE)
  -n, --dry-run        show what would change, store nothing
  -l, --lock-after     lock the Bitwarden vault again if this script unlocked it
  -h, --help           show this help

Each custom field becomes one keyring entry: service=SERVICE, username=FIELD.
If the vault is locked, rbw will prompt for your master password (run `rbw login` once first).
EOF
}

while [[ $# -gt 0 ]]; do
    case $1 in
        -i|--item) ITEM=${2:?missing value for $1}; shift 2 ;;
        -s|--service) SERVICE=${2:?missing value for $1}; shift 2 ;;
        -n|--dry-run) DRY_RUN=1; shift ;;
        -l|--lock-after) LOCK_AFTER=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
done

for tool in rbw secret-tool jq; do
    command -v "$tool" >/dev/null || { echo "error: '$tool' not found in PATH" >&2; exit 1; }
done

# The keyring must exist and be unlocked, otherwise there is nothing to sync into.
if command -v busctl >/dev/null; then
    state=$(busctl --user get-property org.freedesktop.secrets \
        /org/freedesktop/secrets/aliases/default \
        org.freedesktop.Secret.Collection Locked 2>/dev/null) || {
        echo "error: no Secret Service on the session bus (is gnome-keyring running?)" >&2
        exit 1
    }
    if [[ $state == "b true" ]]; then
        echo "error: the default keyring is locked; unlock it and retry" >&2
        exit 1
    fi
fi

unlocked_here=0
if ! rbw unlocked >/dev/null 2>&1; then
    # rbw prompts for the master password via pinentry (log in first with `rbw login`).
    rbw unlock
    unlocked_here=1
fi

cleanup() {
    if [[ $LOCK_AFTER -eq 1 && $unlocked_here -eq 1 ]]; then
        rbw lock >/dev/null 2>&1 || true
    fi
}
trap cleanup EXIT

rbw sync >/dev/null
json=$(rbw get --raw "$ITEM") || { echo "error: Bitwarden item '$ITEM' not found" >&2; exit 1; }

added=0 updated=0 unchanged=0 skipped=0
while IFS= read -r name; do
    value=$(jq -j --arg n "$name" '[.fields[] | select(.name == $n)][0].value // ""' <<<"$json")
    if [[ -z $value ]]; then
        echo "skip       $name (empty value)"
        skipped=$((skipped + 1))
        continue
    fi

    if current=$(timeout 5 secret-tool lookup service "$SERVICE" username "$name" 2>/dev/null); then
        have=1
    else
        have=0
        current=""
    fi

    if [[ $have -eq 1 && $current == "$value" ]]; then
        echo "unchanged  $name"
        unchanged=$((unchanged + 1))
        continue
    fi

    action=added
    [[ $have -eq 1 ]] && action=updated
    if [[ $DRY_RUN -eq 1 ]]; then
        echo "would be ${action} $name"
    else
        printf '%s' "$value" | secret-tool store --label="$SERVICE" \
            service "$SERVICE" username "$name"
        echo "${action}      $name"
    fi
    [[ $action == added ]] && added=$((added + 1)) || updated=$((updated + 1))
done < <(jq -r '.fields[]? | .name // empty' <<<"$json")

echo "done: $added added, $updated updated, $unchanged unchanged, $skipped skipped"
[[ $DRY_RUN -eq 1 ]] && echo "(dry run, nothing was stored)"
exit 0
